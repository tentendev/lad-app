{
  "name": "deep-space-ledger",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "sync:expo-data": "node scripts/sync-expo-schedule.mjs",
    "export:web": "npm run sync:expo-data && expo export --platform web && node scripts/write-precache-manifest.mjs",
    "verify:web": "node scripts/verify-web-export.mjs",
    "release:web": "npm run check && npm run doctor && npm run security:audit && npm run export:web && npm run verify:web",
    "release:ios:validate": "npm run check && npm run doctor && npm run security:audit && npm run verify:ios-bundle && npm run preflight:ios-build",
    "verify:vercel-prebuilt": "node scripts/verify-vercel-prebuilt.mjs",
    "preflight:web-deploy": "node scripts/preflight-web-deploy.mjs",
    "verify:web-deployment": "node scripts/verify-deployed-web.mjs",
    "verify:ios-bundle": "node scripts/verify-ios-export.mjs",
    "preflight:ios-build": "node scripts/preflight-ios-build.mjs",
    "preflight:ios-submit": "node --env-file-if-exists=.env.local scripts/preflight-ios-submit.mjs",
    "security:audit": "node scripts/audit-production-dependencies.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate-cloud-db.mjs",
    "smoke:cloud": "node --env-file=.env.local scripts/smoke-cloud-sync.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "doctor": "npx expo-doctor",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/sync-official-schedule.test.mjs && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.5",
    "@clerk/expo": "^4.2.8",
    "@expo/metro-runtime": "~57.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@gsap/react": "^2.1.2",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@neondatabase/serverless": "^1.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.14",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.7",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.0",
    "expo-web-browser": "~57.0.2",
    "gsap": "^3.15.0",
    "heroui-native": "^1.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "~19.2.15",
    "@vercel/node": "^5.9.9",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.0",
    "postcss": "^8.5.6",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  }
}
