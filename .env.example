# Public values embedded in the Expo client. Never put Clerk secret keys or database URLs in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_ENABLE_APPLE_SIGN_IN=false
EXPO_PUBLIC_ENABLE_DEBUG_TOOLS=false
EXPO_PUBLIC_SYNC_API_URL=https://lad-pocket.vercel.app
EXPO_PUBLIC_LEGAL_ENTITY_NAME=
EXPO_PUBLIC_SUPPORT_EMAIL=

# Server-only values for Vercel API routes. Keep these out of Expo/EAS client variables and source control.
CLERK_SECRET_KEY=
DATABASE_URL=
CLERK_AUTHORIZED_PARTIES=https://lad-pocket.vercel.app

# Required for automatic Sign in with Apple token revocation during account deletion.
# APPLE_PRIVATE_KEY is the full .p8 contents; in dashboards it may be stored with escaped \n line breaks.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_NATIVE_CLIENT_ID=com.tenten.deepspaceledger
APPLE_WEB_CLIENT_ID=

# Non-secret release attestations. Set only after the named work is actually complete.
PRODUCTION_SECRETS_ROTATED=false
CLERK_NATIVE_APP_CONFIGURED=false
CLERK_GOOGLE_OAUTH_CONFIGURED=false
CLERK_APPLE_OAUTH_CONFIGURED=false
APPLE_CONTENT_RIGHTS_STATUS=
